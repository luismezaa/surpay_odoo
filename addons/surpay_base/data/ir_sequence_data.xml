<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_surpay_cash_closure" model="ir.sequence">
        <field name="name">Surpay Cierre de caja</field>
        <field name="code">surpay.cash.closure</field>
        <field name="prefix">CC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_surpay_payment_reconciliation" model="ir.sequence">
        <field name="name">Surpay Conciliacion de pagos</field>
        <field name="code">surpay.payment.reconciliation</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
