<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_surpay" model="ir.module.category">
        <field name="name">Surpay</field>
        <field name="description">Surpay specific access rights</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_surpay_manager" model="res.groups">
        <field name="name">Surpay Manager</field>
        <field name="category_id" ref="surpay_base.module_category_surpay"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Full access to Surpay configuration and reports.</field>
    </record>

    <record id="group_surpay_restricted_user" model="res.groups">
        <field name="name">Surpay Restricted User</field>
        <field name="category_id" ref="surpay_base.module_category_surpay"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can access Odoo backend but only sees Surpay menu tree.</field>
    </record>

    <!-- Record rules: block URL-level access to non-Surpay models for restricted users -->

    <record id="rule_surpay_restricted_no_partner" model="ir.rule">
        <field name="name">Surpay Restricted: solo su propio contacto</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('surpay_base.group_surpay_restricted_user'))]"/>
        <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_surpay_restricted_own_transactions" model="ir.rule">
        <field name="name">Surpay Restricted: solo sus propias transacciones</field>
        <field name="model_id" ref="surpay_base.model_surpay_payment_transaction"/>
        <field name="groups" eval="[(4, ref('surpay_base.group_surpay_restricted_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_surpay_restricted_no_discuss_channel" model="ir.rule">
        <field name="name">Surpay Restricted: sin acceso a Conversaciones</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="groups" eval="[(4, ref('surpay_base.group_surpay_restricted_user'))]"/>
        <field name="domain_force">[('id', '=', False)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
