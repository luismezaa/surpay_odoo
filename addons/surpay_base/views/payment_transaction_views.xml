<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="surpay_payment_transaction_list" model="ir.ui.view">
        <field name="name">surpay.payment.transaction.list</field>
        <field name="model">surpay.payment.transaction</field>
        <field name="arch" type="xml">
            <list string="Panel de ventas" create="0" edit="0" delete="0">
                <field name="create_date" string="Creada"/>
                <field name="order_id"/>
                <field name="concept"/>
                <field name="state"/>
                <button
                    name="action_download_zebra_voucher"
                    type="object"
                    string="Voucher TXT"
                    class="btn-link"
                    icon="fa-download"
                    invisible="state != 'paid'"
                />
                <field name="sales_channel"/>
                <field name="partner_id" groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_provider_user,base.group_system"/>
                <field name="client_id" groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_provider_user,base.group_system"/>
                <field name="provider" groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_provider_user,base.group_system"/>
                <field name="base_amount"/>
                <field name="commission_percent"/>
                <field name="commission_amount"/>
                <field name="amount"/>
                <field name="currency"/>
                <field name="qr_converted_amount" string="Monto Destino"/>
                <field name="qr_currency" string="Moneda Destino"/>
                <field name="qr_exchange_rate" string="Tipo Cambio"/>
                <field name="transferred"/>
                <field name="cash_closure_id"/>
                <field
                    name="external_order_id"
                    groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_restricted_user,surpay_base.group_surpay_provider_user,base.group_system"
                />
            </list>
        </field>
    </record>

    <record id="surpay_payment_transaction_form" model="ir.ui.view">
        <field name="name">surpay.payment.transaction.form</field>
        <field name="model">surpay.payment.transaction</field>
        <field name="arch" type="xml">
            <form string="Detalle de venta" create="0" delete="0">
                <sheet>
                    <group>
                        <group string="Transaccion">
                            <field name="order_id" readonly="1"/>
                            <field name="provider" readonly="1" groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_provider_user,base.group_system"/>
                            <field name="provider_payment_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group string="Metadatos de venta">
                            <field name="sales_channel" readonly="1"/>
                            <field name="partner_id" readonly="1" groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_provider_user,base.group_system"/>
                            <field name="client_id" readonly="1" groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_provider_user,base.group_system"/>
                            <field name="seller_user_id" readonly="1"/>
                            <field name="concept" readonly="1"/>
                            <field name="customer_email" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Montos">
                            <field name="base_amount" readonly="1"/>
                            <field name="commission_percent" readonly="1"/>
                            <field name="commission_amount" readonly="1"/>
                            <field name="commission_rule_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency" readonly="1"/>
                            <field name="qr_converted_amount" readonly="1"/>
                            <field name="qr_currency" readonly="1"/>
                            <field name="qr_exchange_rate" readonly="1"/>
                        </group>
                        <group string="Liquidacion">
                            <field name="transferred" readonly="1"/>
                            <field name="cash_closure_id" readonly="1"/>
                            <field
                                name="external_order_id"
                                readonly="1"
                                groups="surpay_base.group_surpay_manager,surpay_base.group_surpay_restricted_user,surpay_base.group_surpay_provider_user,base.group_system"
                            />
                        </group>
                    </group>
                    <group string="Respuesta cruda del proveedor">
                        <field name="provider_raw" readonly="1" widget="json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="surpay_payment_transaction_search" model="ir.ui.view">
        <field name="name">surpay.payment.transaction.search</field>
        <field name="model">surpay.payment.transaction</field>
        <field name="arch" type="xml">
            <search string="Panel de ventas">
                <field name="order_id"/>
                <field name="external_order_id"/>
                <field name="partner_id"/>
                <field name="client_id"/>
                <field name="sales_channel"/>
                <field name="provider"/>
                <field name="state"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <filter name="pending" string="Pendientes" domain="[('state', 'in', ['created', 'pending'])]"/>
                <filter name="failed" string="Fallidas" domain="[('state', 'in', ['failed', 'expired', 'cancelled'])]"/>
                <filter name="internal" string="Internas" domain="[('sales_channel', '=', 'internal')]"/>
                <filter name="external" string="Externas" domain="[('sales_channel', '=', 'external')]"/>
                <filter name="not_transferred" string="No transferidas" domain="[('transferred', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="surpay_payment_transaction_action" model="ir.actions.act_window">
        <field name="name">Panel de ventas</field>
        <field name="res_model">surpay.payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_paid': 1}</field>
    </record>

    <record id="surpay_menu_root" model="ir.ui.menu">
        <field name="action" ref="surpay_payment_transaction_action"/>
    </record>

    <menuitem
        id="surpay_payment_transaction_menu"
        name="Panel de ventas"
        parent="surpay_menu_root"
        action="surpay_payment_transaction_action"
        sequence="3"
    />
</odoo>
