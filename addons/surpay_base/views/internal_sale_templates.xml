<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="surpay_new_sale_url_action" model="ir.actions.act_url">
        <field name="name">Nueva Venta</field>
        <field name="url">/surpay/new-sale</field>
        <field name="target">self</field>
    </record>

    <menuitem
        id="surpay_new_sale_menu"
        name="Nueva Venta"
        parent="surpay_menu_root"
        action="surpay_new_sale_url_action"
        groups="surpay_base.group_surpay_restricted_user,surpay_base.group_surpay_manager,base.group_system"
        sequence="0"
    />

    <template id="new_sale_page" name="Surpay New Sale">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Nueva Venta</title>
                <style>
                    :root {
                        --bg: #f4f6f8;
                        --card: #ffffff;
                        --line: #d9e1ea;
                        --text: #1d2a39;
                        --muted: #5d6b7b;
                        --primary: #0b5394;
                    }
                    * { box-sizing: border-box; }
                    body {
                        margin: 0;
                        min-height: 100vh;
                        font-family: "Segoe UI", Tahoma, sans-serif;
                        background: radial-gradient(circle at 0% 0%, #eef4fb 0%, var(--bg) 45%, #e9eff5 100%);
                        color: var(--text);
                    }
                    .wrap {
                        max-width: 720px;
                        margin: 42px auto;
                        padding: 0 18px;
                    }
                    .card {
                        background: var(--card);
                        border: 1px solid var(--line);
                        border-radius: 16px;
                        padding: 28px;
                        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.08);
                    }
                    .hero {
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        gap: 14px;
                        margin-bottom: 18px;
                        padding-bottom: 18px;
                        border-bottom: 1px solid #e5ebf2;
                        text-align: center;
                    }
                    .hero-logo {
                        width: 164px;
                        max-width: 64vw;
                        height: auto;
                        display: block;
                        flex: 0 0 auto;
                        margin-top: 4px;
                    }
                    .hero-copy {
                        min-width: 0;
                        max-width: 100%;
                    }
                    h1 {
                        margin: 0;
                        font-size: 27px;
                    }
                    .subtitle {
                        margin: 8px 0 0;
                        color: var(--muted);
                    }
                    .field { margin-bottom: 14px; }
                    label {
                        display: block;
                        margin-bottom: 6px;
                        font-weight: 600;
                    }
                    input, select {
                        width: 100%;
                        height: 44px;
                        border: 1px solid #c5cfda;
                        border-radius: 10px;
                        padding: 0 12px;
                        font-size: 15px;
                    }
                    .provider-grid {
                        display: grid;
                        grid-template-columns: repeat(auto-fill, minmax(150px, 150px));
                        gap: 12px;
                        justify-content: start;
                    }
                    .provider-card {
                        border: 1px solid #c5cfda;
                        border-radius: 12px;
                        padding: 10px 12px;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: flex-start;
                        min-height: 128px;
                        cursor: pointer;
                        background: #fff;
                        transition: all .12s ease;
                    }
                    .provider-card:hover {
                        border-color: #7aa5cf;
                        box-shadow: 0 8px 18px rgba(11, 83, 148, 0.08);
                    }
                    .provider-radio {
                        width: 18px;
                        height: 18px;
                        margin-top: 8px;
                        order: 2;
                        accent-color: var(--primary);
                    }
                    .provider-card-body {
                        order: 1;
                        width: 100%;
                        display: grid;
                        place-items: center;
                        border-radius: 8px;
                        padding: 8px;
                    }
                    .provider-logo {
                        width: 72px;
                        height: 72px;
                        border-radius: 10px;
                        border: 1px solid #d7e0ea;
                        object-fit: contain;
                        object-position: center;
                        background: #f1f5f9;
                        padding: 4px;
                    }
                    .provider-logo.fallback {
                        display: grid;
                        place-items: center;
                        font-weight: 700;
                        color: #355374;
                    }
                    .provider-radio:checked + .provider-card-body {
                        outline: 2px solid #0b5394;
                        outline-offset: 1px;
                        border-radius: 8px;
                    }
                    .actions {
                        margin-top: 18px;
                        display: flex;
                        gap: 10px;
                    }
                    button, .actions a {
                        height: 44px;
                        border: 0;
                        border-radius: 10px;
                        padding: 0 16px;
                        font-weight: 700;
                        cursor: pointer;
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        text-decoration: none;
                    }
                    .primary {
                        background: var(--primary);
                        color: #fff;
                    }
                    .secondary {
                        background: #e7ebf0;
                        color: #1f2a37;
                    }
                    .msg {
                        margin-top: 14px;
                        min-height: 22px;
                        color: #b91c1c;
                        font-weight: 600;
                    }
                    @media (max-width: 640px) {
                        .card {
                            padding: 20px;
                        }
                        .hero-logo {
                            width: 150px;
                            max-width: 68vw;
                        }
                        h1 {
                            font-size: 24px;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <div class="card">
                        <div class="hero">
                            <img class="hero-logo" src="/surpay_base/static/description/src/full_logo.png" alt="Surpay"/>
                            <div class="hero-copy">
                                <h1>Nueva Venta</h1>
                                <p class="subtitle">Completa los datos y abre el pago en una pestaña nueva.</p>
                            </div>
                        </div>

                        <div class="field">
                            <label for="amount_clp">Precio en Pesos</label>
                            <input id="amount_clp" type="number" min="1" step="1" placeholder="Ej: 25000"/>
                        </div>
                        <div class="field">
                            <label for="concept">Código de referencia (concepto)</label>
                            <input id="concept" type="text" placeholder="Ej: Compra TV 42"/>
                        </div>
                        <div class="field">
                            <label for="email">Correo Electrónico</label>
                            <input id="email" type="email" placeholder="cliente@correo.com"/>
                        </div>
                        <div class="field">
                            <label>Plataforma de pago</label>
                            <div class="provider-grid">
                                <t t-foreach="provider_configs" t-as="cfg">
                                    <label class="provider-card">
                                        <input
                                            class="provider-radio"
                                            type="radio"
                                            name="provider_config_id"
                                            t-att-value="cfg.id"
                                            t-att-data-provider="cfg.provider"
                                            t-att-data-config-id="cfg.id"
                                            t-att-checked="cfg.id == default_provider_config_id and 'checked' or None"
                                        />
                                        <div class="provider-card-body">
                                            <t t-if="cfg.logo">
                                                <img class="provider-logo" t-att-src="'/surpay/provider-logo/%s?v=%s' % (cfg.id, (cfg.write_date or ''))" t-att-alt="cfg.display_name"/>
                                            </t>
                                            <t t-else="">
                                                <div class="provider-logo fallback"><t t-esc="(cfg.provider or '?').upper()[:2]"/></div>
                                            </t>
                                        </div>
                                    </label>
                                </t>
                            </div>
                        </div>

                        <div class="field" id="kushkiTerminalField" style="display:none;">
                            <label for="terminal_id">Terminal Kushki</label>
                            <select id="terminal_id">
                                <option value="">Selecciona una terminal</option>
                            </select>
                        </div>

                        <div class="field" id="qrFromField">
                            <label for="qr_from">Pais origen</label>
                            <select id="qr_from">
                                <t t-foreach="qr_from_options" t-as="opt">
                                    <option t-att-value="opt[0]" t-att-selected="opt[0] == default_qr_from and 'selected' or None">
                                        <t t-esc="opt[2]"/> <t t-esc="opt[1]"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="actions">
                            <button id="submitBtn" class="primary">Ir a pagar</button>
                            <a class="secondary" t-att-href="odoo_return_url">Volver</a>
                        </div>
                        <div id="msg" class="msg"></div>
                        <div id="kushkiTerminalsData" t-att-data-json="kushki_terminals_by_config_json" style="display:none"></div>
                    </div>
                </div>

                <script type="text/javascript">
                    <![CDATA[
                    var kushkiTerminalsByConfig = {};
                    var kushkiTerminalsData = document.getElementById("kushkiTerminalsData");
                    if (kushkiTerminalsData) {
                        try {
                            kushkiTerminalsByConfig = JSON.parse(kushkiTerminalsData.getAttribute("data-json") || "{}");
                        } catch (error) {
                            kushkiTerminalsByConfig = {};
                        }
                    }
                    ]]>
                </script>
                <script type="text/javascript">
                    <![CDATA[
                    (function () {
                        var submitBtn = document.getElementById("submitBtn");
                        var msg = document.getElementById("msg");
                        var kushkiTerminalField = document.getElementById("kushkiTerminalField");
                        var kushkiTerminalSelect = document.getElementById("terminal_id");
                        var kushkiCountryField = document.getElementById("qrFromField");

                        function getVal(id) {
                            var el = document.getElementById(id);
                            return el ? el.value : "";
                        }

                        function getSelectedProviderRadio() {
                            return document.querySelector('input[name="provider_config_id"]:checked');
                        }

                        function getSelectedProviderInfo() {
                            var radio = getSelectedProviderRadio();
                            if (!radio) {
                                return null;
                            }
                            return {
                                id: parseInt(radio.value, 10),
                                provider: radio.getAttribute("data-provider") || "",
                                configId: radio.getAttribute("data-config-id") || radio.value,
                            };
                        }

                        function escapeHtml(value) {
                            return String(value || "")
                                .replace(/&/g, "&amp;")
                                .replace(/</g, "&lt;")
                                .replace(/>/g, "&gt;")
                                .replaceAll('"', "&quot;")
                                .replace(/'/g, "&#39;");
                        }

                        function renderKushkiTerminals(configId) {
                            if (!kushkiTerminalSelect) {
                                return;
                            }
                            var terminals = kushkiTerminalsByConfig && kushkiTerminalsByConfig[String(configId)] ? kushkiTerminalsByConfig[String(configId)] : [];
                            var html = ['<option value="">Selecciona una terminal</option>'];
                            terminals.forEach(function (terminal) {
                                var label = terminal && terminal.label ? String(terminal.label) : String(terminal.terminal_serial || terminal.id || "");
                                html.push('<option value="' + String(terminal.id) + '">' + escapeHtml(label) + '</option>');
                            });
                            kushkiTerminalSelect.innerHTML = html.join("");
                        }

                        function toggleKushkiTerminalSelector() {
                            var info = getSelectedProviderInfo();
                            if (!kushkiTerminalField || !kushkiTerminalSelect) {
                                return;
                            }
                            if (info && info.provider === "kushki") {
                                renderKushkiTerminals(info.id);
                                kushkiTerminalField.style.display = "block";
                                if (kushkiCountryField) {
                                    kushkiCountryField.style.display = "none";
                                }
                                return;
                            }
                            kushkiTerminalField.style.display = "none";
                            kushkiTerminalSelect.value = "";
                            kushkiTerminalSelect.innerHTML = '<option value="">Selecciona una terminal</option>';
                            if (kushkiCountryField) {
                                kushkiCountryField.style.display = "block";
                            }
                        }

                        function setMessage(text) {
                            msg.textContent = text || "";
                        }

                        function startPayment() {
                            setMessage("");
                            var amount = parseFloat(getVal("amount_clp") || "0");
                            var concept = (getVal("concept") || "").trim();
                            var email = (getVal("email") || "").trim();
                            var providerInfo = getSelectedProviderInfo();
                            var opensPaymentTab = !providerInfo || providerInfo.provider !== "kushki";
                            var providerConfigId = providerInfo ? providerInfo.id : 0;
                            var qrFrom = (getVal("qr_from") || "").toUpperCase().trim();
                            var terminalId = kushkiTerminalSelect ? (kushkiTerminalSelect.value || "").trim() : "";

                            if (!(amount > 0)) {
                                setMessage("Ingresa un precio válido en pesos.");
                                return;
                            }
                            if (!concept) {
                                setMessage("Ingresa el código de referencia (concepto).");
                                return;
                            }
                            if (!providerConfigId) {
                                setMessage("Selecciona una plataforma de pago.");
                                return;
                            }
                            if (providerInfo && providerInfo.provider !== "kushki" && !qrFrom) {
                                setMessage("Selecciona un pais para origen QR.");
                                return;
                            }
                            if (providerInfo && providerInfo.provider === "kushki" && !terminalId) {
                                setMessage("Selecciona una terminal Kushki.");
                                return;
                            }

                            var paymentTab = opensPaymentTab ? window.open("about:blank", "_blank") : null;
                            submitBtn.disabled = true;
                            submitBtn.textContent = "Procesando...";

                            fetch("/surpay/new-sale/start", {
                                method: "POST",
                                headers: {"Content-Type": "application/json"},
                                body: JSON.stringify({
                                    amount_clp: amount,
                                    concept: concept,
                                    email: email,
                                    provider_config_id: providerConfigId,
                                    qr_from: providerInfo && providerInfo.provider === "kushki" ? "" : qrFrom,
                                    terminal_id: terminalId,
                                }),
                            })
                                .then(function (res) { return res.json(); })
                                .then(function (payload) {
                                    var result = payload && payload.result ? payload.result : payload;
                                    if (!result || result.error) {
                                        var errorMessage = (result && result.error && result.error.message) || "No fue posible iniciar el pago.";
                                        if (paymentTab && !paymentTab.closed) {
                                            paymentTab.close();
                                        }
                                        setMessage(errorMessage);
                                        submitBtn.disabled = false;
                                        submitBtn.textContent = "Ir a pagar";
                                        return;
                                    }

                                    if (opensPaymentTab && paymentTab && !paymentTab.closed) {
                                        paymentTab.location.href = result.payment_url;
                                    } else if (opensPaymentTab) {
                                        window.open(result.payment_url, "_blank");
                                    }

                                    window.location.href = result.processing_url;
                                })
                                .catch(function () {
                                    if (paymentTab && !paymentTab.closed) {
                                        paymentTab.close();
                                    }
                                    setMessage("Error de conexión al iniciar el pago.");
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = "Ir a pagar";
                                });
                        }

                        document.querySelectorAll('input[name="provider_config_id"]').forEach(function (radio) {
                            radio.addEventListener("change", toggleKushkiTerminalSelector);
                        });

                        toggleKushkiTerminalSelector();
                        if (kushkiCountryField) {
                            var initialProvider = getSelectedProviderInfo();
                            kushkiCountryField.style.display = initialProvider && initialProvider.provider === "kushki" ? "none" : "block";
                        }
                        submitBtn.addEventListener("click", startPayment);
                    })();
                    ]]>
                </script>
            </body>
        </html>
    </template>

    <template id="new_sale_processing_page" name="Surpay New Sale Processing">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Procesando Pago</title>
                <style>
                    body {
                        margin: 0;
                        min-height: 100vh;
                        font-family: "Segoe UI", Tahoma, sans-serif;
                        display: grid;
                        place-items: center;
                        background: #f3f6fb;
                        color: #1f2937;
                    }
                    .box {
                        width: min(560px, 92vw);
                        background: #fff;
                        border: 1px solid #d9e1ea;
                        border-radius: 16px;
                        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.08);
                        padding: 28px;
                        text-align: center;
                    }
                    .spinner {
                        width: 52px;
                        height: 52px;
                        border: 4px solid #dbe3ef;
                        border-top-color: #0b5394;
                        border-radius: 50%;
                        margin: 4px auto 14px;
                        animation: spin 1s linear infinite;
                    }
                    @keyframes spin {
                        to { transform: rotate(360deg); }
                    }
                    .state {
                        font-weight: 700;
                        margin-top: 12px;
                    }
                    .hint {
                        color: #5b6472;
                    }
                </style>
            </head>
            <body>
                <div class="box" t-att-data-order-id="order_id" t-att-data-provider="provider">
                    <div class="spinner"></div>
                    <h1>Procesando pago</h1>
                    <p class="hint" t-if="provider == 'kushki'">La terminal Kushki esta procesando el pago. Espera confirmación para continuar.</p>
                    <p class="hint" t-else="">El pago se abrió en otra pestaña. Espera confirmación para continuar.</p>
                    <p class="state">Estado actual: <span id="stateLabel"><t t-esc="state"/></span></p>
                    <p class="hint">Concepto: <t t-esc="concept or '-'"/> | Monto: <t t-esc="amount"/> <t t-esc="currency"/></p>
                </div>

                <script type="text/javascript">
                    <![CDATA[
                    (function () {
                        var box = document.querySelector(".box");
                        var label = document.getElementById("stateLabel");
                        if (!box || !label) {
                            return;
                        }
                        var orderId = box.getAttribute("data-order-id");
                        var provider = (box.getAttribute("data-provider") || "").toLowerCase();
                        if (!orderId) {
                            return;
                        }

                        function poll() {
                            fetch("/surpay/new-sale/status/" + encodeURIComponent(orderId), {
                                method: "POST",
                                headers: {"Content-Type": "application/json"},
                                body: "{}",
                            })
                                .then(function (res) { return res.json(); })
                                .then(function (payload) {
                                    var result = payload && payload.result ? payload.result : payload;
                                    if (!result || result.error) {
                                        window.setTimeout(poll, 5000);
                                        return;
                                    }

                                    label.textContent = result.state;

                                    if (result.done) {
                                        if (result.paid) {
                                            window.location.href = "/surpay/new-sale/success/" + encodeURIComponent(orderId);
                                            return;
                                        }
                                        if (result.failed) {
                                            window.location.href = "/surpay/new-sale/failed/" + encodeURIComponent(orderId);
                                            return;
                                        }
                                    }

                                    window.setTimeout(poll, 4000);
                                })
                                .catch(function () {
                                    window.setTimeout(poll, 6000);
                                });
                        }

                        var firstPollDelay = provider === "kushki" ? 900 : 2500;
                        window.setTimeout(poll, firstPollDelay);
                    })();
                    ]]>
                </script>
            </body>
        </html>
    </template>

    <template id="new_sale_success_page" name="Surpay New Sale Success">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Pago Exitoso</title>
                <style>
                    body { font-family: "Segoe UI", Tahoma, sans-serif; background: #f2f8f4; margin: 0; }
                    .box { max-width: 560px; margin: 70px auto; background: #fff; border: 1px solid #d3e7da; border-radius: 14px; padding: 24px; text-align: center; }
                    h1 { color: #166534; margin-top: 0; }
                    a { display: inline-block; margin-top: 14px; padding: 10px 14px; background: #166534; color: #fff; border-radius: 8px; text-decoration: none; }
                    .actions { margin-top: 18px; display: flex; justify-content: center; gap: 10px; }
                    .actions a { margin-top: 0; }
                    .secondary { background: #334155; }
                </style>
            </head>
            <body>
                <div class="box">
                    <h1>Pago completado</h1>
                    <p t-if="concept">Concepto: <strong><t t-esc="concept"/></strong></p>
                    <p>La transacción <strong><t t-esc="order_id"/></strong> fue pagada exitosamente.</p>
                    <div class="actions">
                        <a href="/surpay/new-sale">Iniciar nueva venta</a>
                        <a class="secondary" t-att-href="odoo_return_url">Volver</a>
                    </div>
                </div>
            </body>
        </html>
    </template>

    <template id="new_sale_failed_page" name="Surpay New Sale Failed">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Pago No Completado</title>
                <style>
                    body { font-family: "Segoe UI", Tahoma, sans-serif; background: #faf4f4; margin: 0; }
                    .box { max-width: 560px; margin: 70px auto; background: #fff; border: 1px solid #efd0d0; border-radius: 14px; padding: 24px; text-align: center; }
                    h1 { color: #991b1b; margin-top: 0; }
                    a { display: inline-block; margin-top: 14px; padding: 10px 14px; background: #991b1b; color: #fff; border-radius: 8px; text-decoration: none; }
                    .actions { margin-top: 18px; display: flex; justify-content: center; gap: 10px; }
                    .actions a { margin-top: 0; }
                    .secondary { background: #334155; }
                </style>
            </head>
            <body>
                <div class="box">
                    <h1>Pago no completado</h1>
                    <p>La transacción <strong><t t-esc="order_id"/></strong> terminó con estado <strong><t t-esc="state"/></strong>.</p>
                    <div class="actions">
                        <a href="/surpay/new-sale">Intentar nueva venta</a>
                        <a class="secondary" t-att-href="odoo_return_url">Volver</a>
                    </div>
                </div>
            </body>
        </html>
    </template>

</odoo>
