<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_surpay_cash_closure_transfer_confirm_wizard_form" model="ir.ui.view">
        <field name="name">surpay.cash.closure.transfer.confirm.wizard.form</field>
        <field name="model">surpay.cash.closure.transfer.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar cierre de caja">
                <group>
                    <field name="closure_id"/>
                    <field
                        name="attachment_ids"
                        widget="many2many_binary"
                        required="1"
                        options="{'accepted_file_extensions': '.pdf,.png,.jpg,.jpeg,.webp'}"
                    />
                    <field name="note" placeholder="Referencia bancaria, observacion, etc."/>
                </group>
                <footer>
                    <button name="action_confirm_close" type="object" string="Confirmar cierre" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
