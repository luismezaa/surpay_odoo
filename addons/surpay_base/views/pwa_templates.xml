<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="surpay_pwa_backend_head" inherit_id="web.webclient_bootstrap" name="Surpay PWA Backend Head">
        <xpath expr="//t[@t-set='head_web']/meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#0b5394"/>
        </xpath>
        <xpath expr="//t[@t-set='head_web']/link[@rel='manifest']" position="replace">
            <link rel="manifest" href="/surpay/manifest.webmanifest" crossorigin="use-credentials"/>
        </xpath>
        <xpath expr="//t[@t-set='head_web']/link[@rel='apple-touch-icon']" position="replace">
            <link rel="apple-touch-icon" href="/surpay_base/static/description/src/img/surpay_512x512.png"/>
        </xpath>
        <xpath expr="//t[@t-set='head_web']" position="inside">
            <meta name="application-name" content="Surpay"/>
            <meta name="apple-mobile-web-app-title" content="Surpay"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="mobile-web-app-capable" content="yes"/>
            <link rel="icon" type="image/svg+xml" href="/surpay_base/static/description/src/img/surpay.svg"/>
        </xpath>
    </template>

    <template id="surpay_pwa_frontend_head" inherit_id="web.layout" name="Surpay PWA Frontend Head">
        <xpath expr="//head" position="inside">
            <link rel="manifest" href="/surpay/manifest.webmanifest"/>
            <meta name="application-name" content="Surpay"/>
            <meta name="apple-mobile-web-app-title" content="Surpay"/>
            <meta name="apple-mobile-web-app-capable" content="yes"/>
            <meta name="mobile-web-app-capable" content="yes"/>
            <meta name="theme-color" content="#0b5394"/>
            <link rel="icon" type="image/svg+xml" href="/surpay_base/static/description/src/img/surpay.svg"/>
            <link rel="apple-touch-icon" href="/surpay_base/static/description/src/img/surpay_512x512.png"/>
        </xpath>
    </template>
</odoo>