<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="surpay_provider_config_list" model="ir.ui.view">
        <field name="name">surpay.provider.config.list</field>
        <field name="model">surpay.provider.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones de proveedor">
                <field name="provider" />
                <field name="environment" />
                <field name="state" />
                <field name="last_test_date" />
                <field name="write_date" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="surpay_provider_config_form" model="ir.ui.view">
        <field name="name">surpay.provider.config.form</field>
        <field name="model">surpay.provider.config</field>
        <field name="arch" type="xml">
            <form string="Configuracion de proveedor">
                <header>
                    <button
                        name="action_test_connection"
                        type="object"
                        string="🔗 Probar conexion"
                        class="btn-primary"
                    />
                    <field name="state" widget="statusbar" options="{'clickable': True}" />
                </header>
                <sheet>
                    <group>
                        <group string="Datos del proveedor">
                            <field name="provider" />
                            <field name="environment" />
                            <field name="logo" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                        </group>
                        <group string="Metadatos">
                            <field name="create_date" />
                            <field name="create_uid" />
                            <field name="write_date" />
                            <field name="write_uid" />
                            <field name="last_test_date" />
                        </group>
                    </group>

                    <notebook>
                        <!-- Depay Specific Credentials -->
                        <page string="Credenciales" name="credentials">
                            <group>
                                <field name="api_key" password="True" help="API Key del proveedor (guardada cifrada)" />
                                <field name="customer_uuid" password="True" help="Customer UUID del proveedor (guardado cifrado)" />
                                <field name="pos_id" password="True" help="ID de punto de venta (guardado cifrado)" />
                                <field name="webhook_secret" password="True" help="Secreto webhook (guardado cifrado)" />
                                <field name="base_url" password="True" help="URL base del API (guardada cifrada)" />
                                <field name="webhook_url" help="URL webhook para recibir callbacks del proveedor" />
                            </group>
                        </page>

                        <!-- Notes -->
                        <page string="Notas" name="notes">
                            <field name="notes" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="surpay_provider_config_search" model="ir.ui.view">
        <field name="name">surpay.provider.config.search</field>
        <field name="model">surpay.provider.config</field>
        <field name="arch" type="xml">
            <search string="Configuraciones de proveedor">
                <field name="provider" />
                <field name="environment" />
                <filter name="active_configs" string="Activas" domain="[('state', '=', 'active')]" />
                <filter name="sandbox" string="Sandbox" domain="[('environment', '=', 'sandbox')]" />
                <filter name="production" string="Produccion" domain="[('environment', '=', 'production')]" />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="surpay_provider_config_action" model="ir.actions.act_window">
        <field name="name">Configuracion de proveedores de pago</field>
        <field name="res_model">surpay.provider.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva configuracion de proveedor de pago
            </p>
            <p>
                Configura credenciales para cada proveedor de pago (Depay, Klap, etc.).
                Las credenciales se cifran y se almacenan de forma segura en la base de datos.
            </p>
        </field>
    </record>

    <menuitem
        id="surpay_menu_root"
        name="Surpay"
        groups="surpay_base.group_surpay_restricted_user,surpay_base.group_surpay_manager,base.group_system"
        sequence="60"
    />

    <!-- Menu Item -->
    <menuitem
        id="surpay_provider_config_menu"
        name="Configuracion de proveedor"
        parent="surpay_menu_root"
        action="surpay_provider_config_action"
        groups="surpay_base.group_surpay_manager,base.group_system"
        sequence="1"
    />
</odoo>
