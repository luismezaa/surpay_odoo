<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="surpay_api_client_list" model="ir.ui.view">
        <field name="name">surpay.api.client.list</field>
        <field name="model">surpay.api.client</field>
        <field name="arch" type="xml">
            <list string="Clientes API">
                <field name="name"/>
                <field name="client_id"/>
                <field name="partner_id"/>
                <field name="ip_filter_mode"/>
                <field name="provider_config_id"/>
                <field name="default_local_currency"/>
                <field name="default_local_country"/>
                <field name="default_qr_from"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="surpay_api_client_form" model="ir.ui.view">
        <field name="name">surpay.api.client.form</field>
        <field name="model">surpay.api.client</field>
        <field name="arch" type="xml">
            <form string="Cliente API">
                <sheet>
                    <group>
                        <group string="Acceso del cliente">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="partner_id"/>
                            <field name="provider_config_id"/>
                            <field name="webhook_url"/>
                            <field name="webhook_secret" password="True"/>
                        </group>
                        <group string="Valores por defecto QR">
                            <field name="default_local_currency" placeholder="ARS"/>
                            <field name="default_local_country" placeholder="AR"/>
                            <field name="default_qr_from" placeholder="AR"/>
                        </group>
                    </group>
                    <group string="Restriccion por IP">
                        <field name="ip_filter_mode"/>
                        <field
                            name="allowed_ips"
                            placeholder="all se maneja con modo=Todas las IPs. Para lista permitida: 192.168.1.10, 10.0.0.0/24"
                            invisible="ip_filter_mode == 'all'"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="surpay_api_client_search" model="ir.ui.view">
        <field name="name">surpay.api.client.search</field>
        <field name="model">surpay.api.client</field>
        <field name="arch" type="xml">
            <search string="Clientes API">
                <field name="name"/>
                <field name="client_id"/>
                <field name="partner_id"/>
                <filter name="active_clients" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="all_ips" string="Todas las IPs" domain="[('ip_filter_mode', '=', 'all')]"/>
                <filter name="allow_list" string="Lista permitida" domain="[('ip_filter_mode', '=', 'list')]"/>
            </search>
        </field>
    </record>

    <record id="surpay_api_client_action" model="ir.actions.act_window">
        <field name="name">Clientes API</field>
        <field name="res_model">surpay.api.client</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="surpay_api_client_menu"
        name="Clientes API"
        parent="surpay_menu_root"
        action="surpay_api_client_action"
        sequence="2"
    />
</odoo>
