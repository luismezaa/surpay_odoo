<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_surpay_payment_reconciliation_event_wizard_form" model="ir.ui.view">
        <field name="name">surpay.payment.reconciliation.event.wizard.form</field>
        <field name="model">surpay.payment.reconciliation.event.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar evento">
                <group>
                    <field name="action_label" readonly="1"/>
                    <field name="observation_required" invisible="1"/>
                    <field name="observation" required="observation_required" placeholder="Ingrese observacion"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
